---
import "../styles/theme.css";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Nicole Thalia Heinimann - PhD Student at TU Berlin",
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body>
        <nav class="nav">
            <div class="nav-container">
                <a href="/" class="nav-brand">ipv3.org</a>
                <div class="nav-links">
                    <a href="/">Home</a>
                    <a href="/publications">Publications</a>
                    <!-- <a href="/cv">CV</a> -->
                    <a href="/blog">Blog</a>
                </div>
            </div>
        </nav>
        <main class="main">
            <slot />
        </main>
        <footer class="footer">
            <p>&copy; 2025 Nicole Thalia Heinimann</p>
        </footer>
    </body>
</html>

<style is:global>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html {
        font-family: var(--font-mono);
        background-color: var(--color-bg);
        color: var(--color-text);
    }

    body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        line-height: 1.6;
    }

    .nav {
        border-bottom: 1px solid var(--color-border);
        padding: 1rem 2rem;
        background-color: var(--color-surface);
    }

    .nav-container {
        max-width: var(--max-width);
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .nav-brand {
        font-weight: bold;
        color: var(--color-accent);
        text-decoration: none;
        font-size: 1.1rem;
    }

    .nav-links {
        display: flex;
        gap: 1.5rem;
    }

    .nav-links a {
        color: var(--color-text);
        text-decoration: none;
        transition: color 0.2s;
    }

    .nav-links a:hover {
        color: var(--color-accent-hover);
    }

    .main {
        flex: 1;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 2rem;
        width: 100%;
    }

    .footer {
        border-top: 1px solid var(--color-border);
        padding: 1.5rem 2rem;
        text-align: center;
        color: var(--color-text-muted);
        font-size: 0.9rem;
        background-color: var(--color-surface);
    }

    a {
        color: var(--color-accent);
        transition: color 0.2s;
    }

    a:hover {
        color: var(--color-accent-hover);
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        margin-top: 1.5em;
        margin-bottom: 0.5em;
        line-height: 1.2;
    }

    h1 {
        font-size: 2rem;
        margin-top: 0;
    }

    p {
        margin-bottom: 1em;
    }

    code {
        background-color: var(--color-surface);
        padding: 0.2em 0.4em;
        border-radius: 3px;
        font-size: 0.9em;
    }

    pre {
        background-color: var(--color-surface);
        padding: 1em;
        border-radius: 5px;
        overflow-x: auto;
        margin: 1em 0;
    }

    pre code {
        background-color: transparent;
        padding: 0;
    }
</style>
