---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="Nicole Thalia Heinimann | Home">
    <h1>Nicole Thalia Heinimann</h1>

    <p class="intro">
        PhD student at TU Berlin, working on programming languages and
        compilers.
    </p>

    <p>
        My research focuses on using machine learning to guide equality
        saturation in e-graphs. I'm also interested in GPU/accelerator
        programming languages and compilers, and Rust-style type systems.
    </p>

    <div class="contact-links">
        <span class="email">
            <a href="mailto:heinimann@tu-berlin.de">
                heinimann@tu-berlin.de
            </a>
        </span>
        <div class="socials">
            <a
                href="https://github.com/SaltyPeppermint"
                target="_blank"
                rel="noopener noreferrer"
            >
                <Icon name="github" />
            </a>
            <a
                href="https://bsky.app/profile/saltypeppermint.bsky.social"
                target="_blank"
                rel="noopener noreferrer"
            >
                <Icon name="bluesky" />
            </a>
            <a
                href="https://types.pl/@SaltyPeppermint"
                target="_blank"
                rel="me noopener noreferrer"
            >
                <Icon name="mastodon" />
            </a>
        </div>
    </div>
</Layout>

<style>
    h1 {
        margin-bottom: 0.25rem;
    }

    .intro {
        color: var(--color-text-muted);
        margin-bottom: 1.5rem;
    }

    .contact-links {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
    }

    .email {
        font-family: var(--font-mono);
        color: var(--color-text-muted);
        font-size: 0.9rem;
    }

    .socials {
        display: flex;
        gap: 0.75rem;
    }

    .contact-links a {
        display: inline-flex;
        align-items: center;
        color: var(--color-text-muted);
    }

    .contact-links a:hover {
        color: var(--color-accent);
    }
</style>
