---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="Nicole Thalia Heinimann | Home">
    <h1>
        I'm a PhD Student at TU Berlin at the chair for Programming Languages
        and Compilers
    </h1>

    <p>
        I'm a doctoral researcher focusing on <strong
            >Machine Learning for Guided Equality Saturation in E-Graphs</strong
        >.
    </p>

    <p>
        I also have interests in GPU programming languages and Rust-style type
        systems.
    </p>

    <h2>Contact</h2>
    <p>Email: &lt;my-last-name&gt;@tu-berlin.de</p>

    <h2>Links</h2>
    <ul class="links">
        <li>
            <a
                href="https://github.com/nicoleh"
                target="_blank"
                rel="noopener noreferrer"
            >
                <Icon name="github" /> GitHub
            </a>
        </li>
        <li>
            <a
                href="https://bsky.app/profile/ipv3.org"
                target="_blank"
                rel="noopener noreferrer"
            >
                <Icon name="bluesky" /> Bluesky
            </a>
        </li>
        <li>
            <a
                href="https://types.pl/@SaltyPeppermint"
                target="_blank"
                rel="me noopener noreferrer"
            >
                <Icon name="mastodon" /> Mastodon
            </a>
        </li>
    </ul>
</Layout>

<style>
    .links {
        list-style: none;
        padding: 0;
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .links li {
        margin: 0;
    }

    .links a {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }
</style>
