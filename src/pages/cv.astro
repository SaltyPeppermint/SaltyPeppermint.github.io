<style>
    section {
        margin-bottom: 2.5rem;
    }

    .empty {
        font-style: italic;
    }

    .cv-list {
        list-style: none;
        padding: 0;
    }

    .cv-item {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--color-border);
    }

    .cv-item:last-child {
        border-bottom: none;
    }

    .cv-date {
        font-size: 0.9rem;
        min-width: 8rem;
    }

    .cv-details {
        flex: 1;
    }

    .cv-title {
        font-weight: bold;
        display: block;
        margin-bottom: 0.25rem;
    }

    .cv-org {
        font-size: 0.9rem;
        margin: 0.25rem 0;
    }

    .cv-desc {
        font-size: 0.9rem;
        margin-top: 0.5rem;
    }
</style>
